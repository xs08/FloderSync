{
  "sourceLanguage" : "en",
  "strings" : {
    "error.autoCommitDisabled" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Uncommitted changes were found, but automatic commit is disabled. Commit them manually or enable automatic commit." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检测到未提交的变更，但自动提交已关闭。请手动提交，或开启自动提交。" } }
      }
    },
    "error.cancelled" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sync was cancelled."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已取消。"
          }
        }
      }
    },
    "error.couldNotCreateStream" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not monitor file-system changes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法监控文件系统变化。"
          }
        }
      }
    },
    "error.couldNotStartStream" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not start monitoring file-system changes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法启动文件系统变化监控。"
          }
        }
      }
    },
    "error.commitIdentityMissing" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No complete Git author identity is available. Configure an author name and email here or in Git." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有可用的完整 Git 提交者身份。请在此处或 Git 中配置名称和邮箱。" } }
      }
    },
    "error.commitMessageMissing" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The automatic commit message is empty. Update the automatic commit configuration." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动提交信息为空，请更新自动提交配置。" } }
      }
    },
    "error.detachedHead" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The repository is in detached HEAD state."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仓库当前处于 detached HEAD 状态。"
          }
        }
      }
    },
    "error.gitUnavailable" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git was not found at %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %@ 未找到 Git。"
          }
        }
      }
    },
    "error.invalidRepository" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected folder is not a readable Git repository."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选文件夹不是可读取的 Git 仓库。"
          }
        }
      }
    },
    "error.operationInProgress" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Git merge, rebase, cherry-pick, or conflict is already in progress. Resolve or abort it before syncing again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仓库正在进行合并、变基、拣选或冲突处理。请先解决或中止该操作，再重新同步。"
          }
        }
      }
    },
    "error.remoteMissing" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote ‘%@’ is not configured."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未配置远端“%@”。"
          }
        }
      }
    },
    "error.timedOut" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Git command timed out."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 命令执行超时。"
          }
        }
      }
    },
    "error.unsupportedSchema" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsupported configuration version: %d."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持的配置版本：%d。"
          }
        }
      }
    },
    "configuration.error.duplicateIdentifier" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The configuration contains duplicate identifiers." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配置中包含重复的唯一标识。" } }
      }
    },
    "configuration.error.duplicateRepositoryPath" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The configuration contains the same repository path more than once." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配置中包含重复的仓库路径。" } }
      }
    },
    "configuration.error.duplicateRuleName" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The configuration contains duplicate automation rule names." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配置中包含重名的自动化规则。" } }
      }
    },
    "configuration.error.fileTooLarge" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The configuration file is larger than the 10 MB limit." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配置文件超过 10 MB 限制。" } }
      }
    },
    "configuration.error.invalidAutomation" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The configuration contains an invalid automation policy." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配置中包含无效的自动化策略。" } }
      }
    },
    "configuration.error.invalidFile" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected file is not a valid FloderSync configuration archive." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所选文件不是有效的 FloderSync 配置归档。" } }
      }
    },
    "configuration.error.loading" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Wait for FloderSync to finish loading before importing or exporting configuration." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请等待 FloderSync 加载完成后再导入或导出配置。" } }
      }
    },
    "configuration.error.missingAutomationRule" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A repository references an automation rule that is not included." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "某个仓库引用了未包含在配置中的自动化规则。" } }
      }
    },
    "configuration.error.missingRequiredValue" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The configuration is missing a required repository or automation value." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配置缺少仓库或自动化规则的必填内容。" } }
      }
    },
    "configuration.error.syncInProgress" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Wait for the current sync to finish before importing configuration." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请等待当前同步完成后再导入配置。" } }
      }
    },
    "configuration.error.unsupportedSchema" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Unsupported configuration archive version: %d." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不支持的配置归档版本：%d。" } }
      }
    },
    "error.watchedFolderUnavailable" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The monitored folder is unavailable: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "监控的文件夹不可用：%@"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
