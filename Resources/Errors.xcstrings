        }
      }
    },
    "error.operationInProgress" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Git merge, rebase, cherry-pick, or conflict is already in progress. Resolve or abort it before syncing again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仓库正在进行合并、变基、拣选或冲突处理。请先解决或中止该操作，再重新同步。"
          }
        }
      }
    },
