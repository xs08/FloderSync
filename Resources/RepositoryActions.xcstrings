    "repository.failure.instruction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve the Git issue manually, then run sync again. FloderSync will not overwrite unresolved changes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请手动解决 Git 问题后再次同步。FloderSync 不会覆盖尚未解决的更改。"
          }
        }
      }
    },
