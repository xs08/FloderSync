    "configuration.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Export repositories, automation rules, and app preferences as JSON. Import replaces the current configuration after validation and confirmation. Sync history and Git credentials are not included." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将仓库、自动化规则和应用偏好导出为 JSON。导入会在校验与确认后替换当前配置，不包含同步历史和 Git 凭据。" } }
      }
    },
    "configuration.export.action" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Export…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导出…" } }
      }
    },
    "configuration.export.picker.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose where to save the FloderSync configuration JSON file." } },
